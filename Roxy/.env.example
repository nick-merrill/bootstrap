# ===================================
# Simple Configuration (dog_monitor.py)
# ===================================

# Single RTSP Camera Configuration
# Example: rtsp://admin:password@192.168.1.100:554/stream
RTSP_URL=rtsp://your-camera-ip:554/stream

# Motion Detection Settings
MOTION_THRESHOLD=1000
MOTION_WINDOW_MINUTES=10

# Frame Processing Settings
FPS_PROCESSING=1

# ===================================
# Advanced Configuration (roxy_monitor.py)
# ===================================

# Wyze Bridge Configuration (if using Wyze cameras)
# See WYZE_SETUP.md for setup instructions
WYZE_EMAIL=your-email@example.com
WYZE_PASSWORD=your-wyze-password

# If you have 2FA enabled (recommended!), add your TOTP secret key
# Get this from Wyze app: Account → 2FA → Set Up → Can't scan? → Copy secret
# See WYZE_2FA.md for detailed instructions
TOTP_KEY=your_totp_secret_key_here

# Multi-Camera RTSP URLs
# For Wyze cameras using docker-wyze-bridge: rtsp://localhost:8554/camera-name
# Replace "camera-name" with actual camera names from Wyze app
CAMERA_LIVING_ROOM_URL=rtsp://localhost:8554/living-room
CAMERA_KITCHEN_URL=rtsp://localhost:8554/kitchen
CAMERA_BACKYARD_URL=rtsp://localhost:8554/backyard

# ===================================
# API Keys (Required for both)
# ===================================

# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MODEL_NAME=claude-3-5-sonnet-20241022

# Twilio Configuration (for SMS and voice notifications)
# Get credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER_1=+1987654321
# TWILIO_TO_NUMBER_2=+1555555555  # Add more as needed

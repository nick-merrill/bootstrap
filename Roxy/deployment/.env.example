# Wyze Bridge Configuration
WYZE_EMAIL=your-email@example.com
WYZE_PASSWORD=your-wyze-password

# If you have 2FA enabled (recommended!), add your TOTP secret key
# Get this from Wyze app: Account → 2FA → Set Up → Can't scan? → Copy secret
# See WYZE_2FA.md for detailed instructions
TOTP_KEY=your_totp_secret_key_here

# Wyze Stream Settings
WYZE_QUALITY=HD120
WYZE_SNAPSHOT=API
WYZE_ON_DEMAND=False
WYZE_LLHLS=True

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER_1=+1234567890

# Camera URLs (these will point to wyze-bridge container)
# Format: rtsp://wyze-bridge:8554/camera-name
# The camera names come from your Wyze app
CAMERA_LIVING_ROOM_URL=rtsp://wyze-bridge:8554/living-room
CAMERA_KITCHEN_URL=rtsp://wyze-bridge:8554/kitchen
CAMERA_BACKYARD_URL=rtsp://wyze-bridge:8554/backyard
